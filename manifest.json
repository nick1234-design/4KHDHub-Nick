{
  "id": "com.nick1234.4khdhub",
  "version": "2.0.0",
  "name": "4KHDHub Nick",
  "description": "Independent movie and series providers",
  "resources": [
    "stream"
  ],
  "types": [
    "movie",
    "series"
  ],
  "catalogs": [],
  "idPrefixes": [
    "tt"
  ],
  "config": [
    {
      "key": "enableShowbox",
      "type": "checkbox",
      "title": "Enable ShowBox",
      "default": "checked"
    },
    {
      "key": "enable4KHDHub",
      "type": "checkbox",
      "title": "Enable 4KHDHub",
      "default": "checked"
    },
    {
      "key": "enableHDHub4u",
      "type": "checkbox",
      "title": "Enable HDHub4u",
      "default": "checked"
    },
    {
      "key": "enablePlayIMDb",
      "type": "checkbox",
      "title": "Enable PlayIMDb",
      "default": "checked"
    },
    {
      "key": "enableCinejoy",
      "type": "checkbox",
      "title": "Enable Cinejoy",
      "default": "checked"
    },
    {
      "key": "enableVAplayer",
      "type": "checkbox",
      "title": "Enable VAplayer",
      "default": "checked"
    },
    {
      "key": "showboxCookies",
      "type": "text",
      "title": "ShowBox cookies (one per line)",
      "default": ""
    },
    {
      "key": "showboxRegion",
      "type": "text",
      "title": "ShowBox region (for example USA7)",
      "default": "USA7"
    }
  ],
  "behaviorHints": {
    "configurable": true,
    "adult": false,
    "p2pNotSupported": true
  }
}